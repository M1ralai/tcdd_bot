# Bearer token copied from your own authenticated TCDD request.
TCDD_TOKEN=

# Passenger details required by the reservation request.
PASSENGER_NAME=
PASSENGER_LAST_NAME=
PASSENGER_BIRTH_DATE=
PASSENGER_GENDER=
PASSENGER_IDENTITY_NUMBER=
PASSENGER_EMAIL=
PASSENGER_PHONE_AREA_CODE=
PASSENGER_PHONE_NUMBER=

# The current implementation supports one standard passenger.
PASSENGER_TYPE_ID=0
PASSENGER_COUNT=1

# Copy route and train values from your own availability request.
FROM_STATION_ID=
FROM_STATION_LABEL=
TO_STATION_ID=
TO_STATION_LABEL=
DEPARTURE_DATE=
SEARCH_RESERVATION=false
TRAIN_TYPES=YHT
TARGET_TRAIN_IDS=

# Optional Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
